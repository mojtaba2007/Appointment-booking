<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site1.master.cs" Inherits="Appointment_booking.Site1" %>

<!DOCTYPE html>

<html dir="rtl">
<head runat="server">
    <title>ریش و قیچی | آرایشگاه مردانه</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link href="../../Content/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="../../Content/Assets/User/CSS/Master.css" rel="stylesheet" />



    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>

    <form id="form1" runat="server">

        <!-- Navbar -->
        <nav class="navbar-container">
            <div class="navbar">

                <a href="Default.aspx" class="navbar-brand">
                    <div class="logo-icon">
                        <img src="../../Content/Assets/Black and White Illustration Barber Shop Logo (1).png" style="width: 20px; z-index: 0; border-radius: 50%;" />
                    </div>
                    <span class="brand-text">ریش و قیچی</span>
                </a>


                <!-- Navigation Links -->
                <ul class="navbar-nav" id="navbarNav" style="margin-right: -6em !important;">
                    <div class="nav-margin">
                        <li class="nav-item">
                            <a href="Default.aspx" class="nav-link">
                                <svg class="nav-icon" viewBox="0 0 24 24">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9,22 9,12 15,12 15,22"></polyline>
                                </svg>
                                <span>خانه</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="BookAppointment.aspx" class="nav-link">
                                <svg class="nav-icon" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                <span>رزرو نوبت</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a href="MyAppointments.aspx" class="nav-link">
                                <svg class="nav-icon" viewBox="0 0 24 24">
                                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                                    <line x1="8" y1="21" x2="16" y2="21"></line>
                                    <line x1="12" y1="17" x2="12" y2="21"></line>
                                </svg>
                                <span>نوبت&zwnj;های من</span>
                            </a>
                        </li>
                    </div>

                    <li id="liLogin" runat="server" visible="false" class="nav-item">
                        <a class="nav-link" href="Login.aspx">ورود</a>
                    </li>

                    <li id="liRegister" runat="server" visible="false" class="nav-item">
                        <a class="btn btn-gold ms-2" href="Register.aspx">ثبت‌نام</a>
                    </li>

                    <li id="liUser" runat="server" visible="false" class="nav-item">
                        <a id="Usertxt" runat="server"
                            class="nav-link"
                            href="Profile.aspx"></a>
                    </li>

                    <li id="liLogout" runat="server" visible="false" class="nav-item">
                        <a class="nav-link text-danger" href="Logout.aspx">خروج</a>
                    </li>

                    <li id="liAdminPanel" runat="server" visible="false" class="nav-item">
                        <a class="cta-button"
                            href="../Admin/Dashboard.aspx">پنل مدیریت </a>
                    </li>
                </ul>

                <!-- Mobile Menu Toggle Button -->
                <button type="button" class="mobile-toggle" id="mobileToggle" aria-label="باز کردن منو">
                    <div class="hamburger">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </button>

            </div>
        </nav>
        <!-- Mobile Menu Overlay -->
        <div class="mobile-menu-overlay" id="mobileMenuOverlay"></div>

        <!-- Mobile Menu -->
        <div class="mobile-menu" id="mobileMenu">
            <div class="mobile-menu-header">
                <a href="Default.aspx" class="mobile-menu-brand">
                    <div class="logo-icon">
                        <img src="../../Content/Assets/Black and White Illustration Barber Shop Logo (1).png" style="width: 20px; border-radius: 50%;" />
                    </div>
                    <span class="brand-text">ریش و قیچی</span>
                </a>
                <button type="button" class="mobile-menu-close" id="mobileMenuClose" aria-label="بستن منو">
                    <span>×</span>
                </button>
            </div>

            <ul class="mobile-menu-nav">
                <li class="mobile-menu-item">
                    <a href="Default.aspx" class="mobile-menu-link nav-link">
                        <svg class="mobile-menu-icon" viewBox="0 0 24 24">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9,22 9,12 15,12 15,22"></polyline>
                        </svg>
                        <span>خانه</span>
                    </a>
                </li>
                <li class="mobile-menu-item">
                    <a href="BookAppointment.aspx" class="mobile-menu-link nav-link">
                        <svg class="mobile-menu-icon" viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="16" x2="12" y2="12"></line>
                            <line x1="12" y1="8" x2="12.01" y2="8"></line>
                        </svg>
                        <span>رزرو نوبت</span>
                    </a>
                </li>
                <li class="mobile-menu-item">
                    <a href="MyAppointments.aspx" class="mobile-menu-link nav-link">
                        <svg class="mobile-menu-icon" viewBox="0 0 24 24">
                            <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                            <line x1="8" y1="21" x2="16" y2="21"></line>
                            <line x1="12" y1="17" x2="12" y2="21"></line>
                        </svg>
                        <span>نوبت&zwnj;های من</span>
                    </a>
                </li>

                <li id="liLoginMobile" runat="server" visible="false" class="mobile-menu-item">
                    <a class="mobile-menu-link" href="Login.aspx" style="justify-content: center !important;">
                        <svg class="mobile-menu-icon" viewBox="0 0 24 24">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                            <polyline points="10 17 15 12 10 7"></polyline>
                            <line x1="15" y1="12" x2="3" y2="12"></line>
                        </svg>
                        <span>ورود</span>
                    </a>
                </li>

                <li id="liUserMobile" runat="server" visible="false" class="mobile-menu-item">
                    <a id="UsertxtMobile" runat="server" class="mobile-menu-link" href="Profile.aspx" style="justify-content: center !important;">
                        <svg class="mobile-menu-icon" viewBox="0 0 24 24">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                            <circle cx="12" cy="7" r="4"></circle>
                        </svg>
                    </a>
                </li>

                <li id="liAdminPanelMobile" runat="server" visible="false" class="mobile-menu-item">
                    <a class="mobile-menu-link" href="../Admin/Dashboard.aspx" style="justify-content: center !important;">
                        <svg class="mobile-menu-icon" viewBox="0 0 24 24">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        <span>پنل مدیریت</span>
                    </a>
                </li>

                <li id="liLogoutMobile" runat="server" visible="false" class="mobile-menu-item">
                    <a class="mobile-menu-link mobile-menu-link-danger" href="Logout.aspx" style="justify-content: center !important;">
                        <svg class="mobile-menu-icon" viewBox="0 0 24 24">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" y1="12" x2="9" y2="12"></line>
                        </svg>
                        <span>خروج</span>
                    </a>
                </li>

                <li id="liRegisterMobile" runat="server" visible="false" class="mobile-menu-item mobile-cta-item">
                    <a class="mobile-cta-button" href="Register.aspx">ثبت‌نام</a>
                </li>
            </ul>
        </div>
        <!-- Main Content -->
        <main class="main-wrapper">
            <div class="container py-5">
                <asp:ContentPlaceHolder ID="MainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </main>

        <!-- Footer -->
        <footer class="footer">
            <div class="footer-content">
                <a href="Default.aspx" class="footer-brand">
                    <div class="footer-logo">
                        <img src="../../Content/Assets/Black and White Illustration Barber Shop Logo (1).png" style="width: 18px; border-radius: 50%;" />
                    </div>
                    <span>ریش و قیچی</span>
                </a>

                <h6>ارتباط با ما:&#9 989000000</h6>

                <div class="footer-social">
                    <a href="#" class="social-link" aria-label="Bale">
                        <img src="../../Content/Assets/bale-color.png" alt="Bale" width="20px" />
                    </a>
                    <a href="#" class="social-link" aria-label="Telegram">
                        <img src="../../Content/Assets/telegram_logo_icon_147228.png" alt="Telegram" width="20px" />
                    </a>
                </div>
            </div>

            <div class="footer-copy">
                © 1405 Built by mojtaba.
           
            </div>
        </footer>

    </form>

    <script src="../Scripts/bootstrap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="../../Content/Assets/User/JS/Master.js"></script>

</body>
</html>
